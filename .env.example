# Server
PORT=4000
# Optional HTTPS directly in Node (no Nginx). Leave empty for plain HTTP.
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
# Without a proxy in front, set TRUST_PROXY=0 so visitors cannot fake their IP.
# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://localhost:3000,http://localhost:3001

# MongoDB connection (e.g. MongoDB Atlas). Leave empty in development to use a
# temporary in-memory database that is re-seeded on every start.
MONGODB_URI=

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin user (created only when the database has no users)
ADMIN_EMAIL=admin@franticpro.com
ADMIN_PASSWORD=admin123

# Email (nodemailer) — lead alerts to the sales team + thank-you email with PDF to the client.
# Gmail / Google Workspace: turn on 2-Step Verification for the account, then create an
# App Password (Google Account → Security → App passwords) and paste it in SMTP_PASS.
# While SMTP_USER or SMTP_PASS is empty, emails are NOT sent — in development they are
# saved to Backend/mail-outbox (.eml + .pdf) so you can check them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@franticpro.com
SMTP_PASS=
MAIL_FROM=Frantic Infotech <sales@franticpro.com>
# Who receives new leads (comma-separated)
LEADS_NOTIFY_TO=sales@franticpro.com
# Send the thank-you email + PDF to the person who filled the form (true / false)
LEAD_AUTO_REPLY=true
# Website address used in emails and the PDF
SITE_URL=https://www.franticpro.com
